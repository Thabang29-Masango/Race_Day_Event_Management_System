@model EventDetailsViewModel
@{
    ViewData["Title"] = Model.Event.Name;
    var session = Context.Session;
    var isParticipant = session.IsLoggedIn() && session.GetRole() == "Participant";
    var returnUrl = "/Events/Details/" + Model.Event.EventId;
}

<a asp-controller="Home" asp-action="Index" class="rd-back">&larr; All events</a>

<div class="rd-card overflow-hidden mt-2 mb-4">
    <partial name="_EventBanner" model="Model.Event" />
    <div class="p-4">
        <span class="event-type-tag">@Model.Event.EventType</span>
        <h1 class="rd-title">@Model.Event.Name</h1>
        <div class="row mt-3">
            <div class="col-md-4 mb-2"><div class="rd-stat-label">Date</div><div class="rd-stat">@Model.Event.EventDate.ToString("dd MMM yyyy")</div></div>
            <div class="col-md-4 mb-2"><div class="rd-stat-label">Location</div><div class="rd-stat">@Model.Event.Location</div></div>
            <div class="col-md-4 mb-2"><div class="rd-stat-label">Distance</div><div class="rd-stat">@Model.Event.DistanceKm.ToString("0.##") km</div></div>
        </div>
        @if (!string.IsNullOrWhiteSpace(Model.Event.Description))
        {
            <p class="mt-3 mb-0">@Model.Event.Description</p>
        }
    </div>
</div>

<h2 class="rd-subtitle">Categories</h2>

@if (!Model.Categories.Any())
{
    <p class="text-muted">The organiser has not added categories for this event yet.</p>
}
else if (isParticipant && !Model.AlreadyEnrolled && !Model.IsPast)
{
    <form asp-action="Enrol" method="post">
        <input type="hidden" name="eventId" value="@Model.Event.EventId" />
        <div class="rd-card">
            <div class="table-responsive">
                <table class="table rd-table mb-0 align-middle">
                    <thead><tr><th></th><th>Category</th><th>Ages</th><th>Distance</th></tr></thead>
                    <tbody>
                    @foreach (var c in Model.Categories)
                    {
                        <tr>
                            <td><input class="form-check-input" type="radio" name="categoryId" value="@c.CategoryId" id="cat@(c.CategoryId)" required /></td>
                            <td><label for="cat@(c.CategoryId)">@c.Name</label></td>
                            <td>@c.MinAge - @c.MaxAge</td>
                            <td>@c.DistanceKm.ToString("0.##") km</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
        <button type="submit" class="btn btn-primary btn-lg mt-3">Enrol now</button>
    </form>
}
else
{
    <div class="rd-card">
        <div class="table-responsive">
            <table class="table rd-table mb-0">
                <thead><tr><th>Category</th><th>Ages</th><th>Distance</th></tr></thead>
                <tbody>
                @foreach (var c in Model.Categories)
                {
                    <tr><td>@c.Name</td><td>@c.MinAge - @c.MaxAge</td><td>@c.DistanceKm.ToString("0.##") km</td></tr>
                }
                </tbody>
            </table>
        </div>
    </div>

    <div class="mt-3">
        @if (Model.IsPast)
        {
            <div class="alert alert-secondary">This event has already taken place.</div>
        }
        else if (Model.AlreadyEnrolled)
        {
            <div class="alert alert-success">You are enrolled for this event.
                <a asp-controller="Participant" asp-action="MyEnrolments">View my enrolments</a></div>
        }
        else if (!session.IsLoggedIn())
        {
            <a asp-controller="Account" asp-action="Login"
               asp-route-returnUrl="@returnUrl" class="btn btn-primary btn-lg">Log in to enrol</a>
        }
        else if (!isParticipant)
        {
            <div class="alert alert-info">Only Participant accounts can enrol for events.</div>
        }
    </div>
}