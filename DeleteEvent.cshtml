@model EventDto
@{
    ViewData["Title"] = "Delete Event";
}
<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="rd-card p-4">
            <h1 class="rd-title mb-3">Delete Event</h1>
            <div class="alert alert-warning">Are you sure you want to delete this event? This cannot be undone.</div>
            <p class="mb-1"><strong>@Model.Name</strong></p>
            <p class="text-muted">@Model.EventDate.ToString("dd MMM yyyy") &middot; @Model.Location</p>
            <form asp-action="DeleteEvent" asp-route-id="@Model.EventId" method="post">
                <button type="submit" class="btn btn-danger">Yes, delete</button>
                <a asp-action="Events" class="btn btn-outline-secondary">Cancel</a>
            </form>
        </div>
    </div>
</div>