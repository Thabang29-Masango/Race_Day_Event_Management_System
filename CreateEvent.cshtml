@model EventFormViewModel
@{
    ViewData["Title"] = "New Event";
}
<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="rd-card p-4">
            <h1 class="rd-title mb-3">New Event</h1>
            <form asp-action="CreateEvent" method="post" enctype="multipart/form-data" novalidate>
                <partial name="_EventForm" model="Model" />
                <button type="submit" class="btn btn-primary">Create event</button>
                <a asp-action="Events" class="btn btn-outline-secondary">Cancel</a>
            </form>
        </div>
    </div>
</div>