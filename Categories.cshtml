@model CategoriesViewModel
@{
    ViewData["Title"] = "Categories";
}
<a asp-action="Events" class="rd-back">&larr; My events</a>
<h1 class="rd-title mt-2">Categories <small>@Model.Event.Name</small></h1>

<div class="row g-4 mt-1">
    <div class="col-lg-7">
        <div class="rd-card">
            @if (!Model.Categories.Any())
            {
                <div class="p-4 text-muted">No categories yet. Add the first one.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table rd-table mb-0 align-middle">
                        <thead><tr><th>Category</th><th>Ages</th><th>Distance</th><th></th></tr></thead>
                        <tbody>
                        @foreach (var c in Model.Categories)
                        {
                            <tr>
                                <td>@c.Name</td>
                                <td>@c.MinAge - @c.MaxAge</td>
                                <td>@c.DistanceKm.ToString("0.##") km</td>
                                <td class="text-end">
                                    <form asp-action="DeleteCategory" method="post"
                                          onsubmit="return confirm('Remove this category?');">
                                        <input type="hidden" name="eventId" value="@Model.Event.EventId" />
                                        <input type="hidden" name="categoryId" value="@c.CategoryId" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Remove</button>
                                    </form>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <div class="col-lg-5">
        <div class="rd-card p-4">
            <h2 class="rd-subtitle">Add a category</h2>
            <form asp-action="AddCategory" asp-route-eventId="@Model.Event.EventId" method="post" novalidate>
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                <div class="mb-3">
                    <label asp-for="NewCategory.Name" class="form-label"></label>
                    <input asp-for="NewCategory.Name" class="form-control" placeholder="e.g. Under 20 - 10 km" />
                    <span asp-validation-for="NewCategory.Name" class="text-danger"></span>
                </div>
                <div class="row">
                    <div class="col-6 mb-3">
                        <label asp-for="NewCategory.MinAge" class="form-label"></label>
                        <input asp-for="NewCategory.MinAge" type="number" min="0" class="form-control" />
                        <span asp-validation-for="NewCategory.MinAge" class="text-danger"></span>
                    </div>
                    <div class="col-6 mb-3">
                        <label asp-for="NewCategory.MaxAge" class="form-label"></label>
                        <input asp-for="NewCategory.MaxAge" type="number" min="0" class="form-control" />
                        <span asp-validation-for="NewCategory.MaxAge" class="text-danger"></span>
                    </div>
                </div>
                <div class="mb-3">
                    <label asp-for="NewCategory.DistanceKm" class="form-label"></label>
                    <input asp-for="NewCategory.DistanceKm" type="number" step="0.1" min="0" class="form-control" />
                    <span asp-validation-for="NewCategory.DistanceKm" class="text-danger"></span>
                </div>
                <button type="submit" class="btn btn-primary">Add category</button>
            </form>
        </div>
    </div>
</div>