@model HomeViewModel
@{
    ViewData["Title"] = "Upcoming Events";
    var loggedIn = Context.Session.IsLoggedIn();
}

<section class="rd-hero">
    <h1>Find your next <span>start line</span></h1>
    <p>Browse upcoming runs, rides and multisport events. Pick a category and enrol in seconds.</p>
    @if (!loggedIn)
    {
        <a asp-controller="Account" asp-action="Register" class="btn btn-primary btn-lg">Join RaceDay</a>
        <a asp-controller="Account" asp-action="Login" class="btn btn-outline-light btn-lg ms-2">Log in</a>
    }
</section>

<form method="get" asp-action="Index" class="rd-card p-3 mb-4">
    <div class="row g-2 align-items-end">
        <div class="col-md-3">
            <label class="form-label" for="search">Search</label>
            <input id="search" name="search" value="@Model.Search" class="form-control" placeholder="Event name" />
        </div>
        <div class="col-md-2">
            <label class="form-label" for="eventType">Type</label>
            <select id="eventType" name="eventType" class="form-select">
                <option value="">All types</option>
                @foreach (var t in Model.EventTypes)
                {
                    <option value="@t" selected="@(string.Equals(t, Model.EventType, StringComparison.OrdinalIgnoreCase))">@t</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label" for="location">Location</label>
            <input id="location" name="location" value="@Model.Location" class="form-control" placeholder="City or venue" />
        </div>
        <div class="col-md-2">
            <label class="form-label" for="fromDate">From</label>
            <input id="fromDate" type="date" name="fromDate" value="@Model.From?.ToString("yyyy-MM-dd")" class="form-control" />
        </div>
        <div class="col-md-2">
            <label class="form-label" for="toDate">To</label>
            <input id="toDate" type="date" name="toDate" value="@Model.To?.ToString("yyyy-MM-dd")" class="form-control" />
        </div>
        <div class="col-md-1">
            <label class="form-label" for="maxDistance">Max km</label>
            <input id="maxDistance" type="number" step="0.1" min="0" name="maxDistance" value="@Model.MaxDistance" class="form-control" />
        </div>
    </div>
    <div class="mt-3">
        <button type="submit" class="btn btn-primary">Apply filters</button>
        @if (Model.HasFilters)
        {
            <a asp-action="Index" class="btn btn-outline-secondary ms-1">Clear</a>
        }
    </div>
</form>

@if (!Model.Events.Any())
{
    <div class="rd-empty">
        <h2 class="rd-title">No events found</h2>
        <p>@(Model.HasFilters ? "Try loosening your filters." : "There are no upcoming events yet. Check back soon.")</p>
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var ev in Model.Events)
        {
            <div class="col-md-6 col-lg-4">
                <div class="rd-card event-card h-100">
                    <partial name="_EventBanner" model="ev" />
                    <div class="p-3 d-flex flex-column">
                        <span class="event-type-tag">@ev.EventType</span>
                        <h2 class="event-card-title">@ev.Name</h2>
                        <ul class="event-meta list-unstyled mb-3">
                            <li><strong>@ev.EventDate.ToString("ddd, dd MMM yyyy")</strong></li>
                            <li>@ev.Location</li>
                            <li>@ev.DistanceKm.ToString("0.##") km</li>
                        </ul>
                        <a asp-controller="Events" asp-action="Details" asp-route-id="@ev.EventId"
                           class="btn btn-primary mt-auto">View event</a>
                    </div>
                </div>
            </div>
        }
    </div>
}